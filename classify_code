// ============================================================
// STEP 2A
// REFERENCE SIGNATURE → IN-STUDY SIMILARITY → PSEUDO TRAINING
// ============================================================
//
// Classes:
// 0 = Banana
// 1 = Paddy
// 2 = Other
//
// Study area:
// Ambasamudram + Cheranmahadevi
//
// Sentinel-2:
// COPERNICUS/S2_SR_HARMONIZED
//
// Period:
// 2025-01-01 to 2026-01-01
//
// Method:
// 1. Build feature stack over reference polygons + study area
// 2. Extract reference signatures
// 3. Standardize features
// 4. Calculate class-wise Euclidean distance
// 5. Find similar pixels INSIDE study area
// 6. Keep high-confidence pixels
// 7. Generate pseudo-training points
// ============================================================


// ============================================================
// 1. SETTINGS
// ============================================================

var startDate_2A = '2025-01-01';
var endDate_2A   = '2026-01-01';

var cloudLimit_2A = 60;

var analysisScale_2A = 10;

// Maximum standardized Euclidean distance
var distanceThreshold_2A = 8.0;

// Minimum ratio between second-best and best class
var separationThreshold_2A = 1.20;

// Maximum candidate points per class
var candidatePerClass_2A = 500;


// ============================================================
// 2. CHECK REFERENCE POLYGONS
// ============================================================

print('============================================================');
print('STEP 2A — REFERENCE INFORMATION');
print('============================================================');

print(
  'All reference polygons:',
  allReferencePolygons.size()
);

print(
  'Banana reference polygons:',
  allBananaReference.size()
);

print(
  'Paddy reference polygons:',
  allPaddyReference.size()
);

print(
  'Other reference polygons:',
  otherReferencePolygons.size()
);


// ============================================================
// 3. REFERENCE + STUDY AREA GEOMETRY
// ============================================================

// IMPORTANT:
// Some Banana/Paddy reference polygons are outside the study area.
//
// Therefore imagery must cover BOTH:
//   - study area
//   - reference polygons
//
// Otherwise the outside reference polygons cannot provide
// spectral signatures.

var referenceGeometry_2A =
  allReferencePolygons.geometry();

var processingGeometry_2A =
  studyArea
    .union(referenceGeometry_2A, 1000);


print(
  'Processing geometry:',
  processingGeometry_2A
);


// ============================================================
// 4. SENTINEL-2 CLOUD / QUALITY MASK
// ============================================================

function maskS2_2A(image) {

  var scl = image.select('SCL');

  var mask = scl.neq(3)   // cloud shadow
    .and(scl.neq(7))      // unclassified
    .and(scl.neq(8))      // cloud medium probability
    .and(scl.neq(9))      // cloud high probability
    .and(scl.neq(10))     // cirrus
    .and(scl.neq(11));    // snow/ice

  return image
    .updateMask(mask)
    .divide(10000)
    .copyProperties(
      image,
      image.propertyNames()
    );
}


// ============================================================
// 5. SENTINEL-2 COLLECTION
// ============================================================

var s2_2A =
  ee.ImageCollection(
    'COPERNICUS/S2_SR_HARMONIZED'
  )
  .filterDate(
    startDate_2A,
    endDate_2A
  )
  .filterBounds(
    processingGeometry_2A
  )
  .filter(
    ee.Filter.lt(
      'CLOUDY_PIXEL_PERCENTAGE',
      cloudLimit_2A
    )
  )
  .map(maskS2_2A);


print(
  'Number of Sentinel-2 images:',
  s2_2A.size()
);


// ============================================================
// 6. SENTINEL-2 MEDIAN COMPOSITE
// ============================================================

var s2Composite_2A =
  s2_2A
    .median()
    .clip(processingGeometry_2A);


// ============================================================
// 7. TERRAIN
// ============================================================

var dem_2A =
  ee.Image('USGS/SRTMGL1_003');

var elevation_2A =
  dem_2A
    .select('elevation')
    .rename('Elevation');

var slope_2A =
  ee.Terrain
    .slope(elevation_2A)
    .rename('Slope');


// ============================================================
// 8. SPECTRAL BANDS
// ============================================================

var B2_2A  = s2Composite_2A.select('B2');
var B3_2A  = s2Composite_2A.select('B3');
var B4_2A  = s2Composite_2A.select('B4');
var B5_2A  = s2Composite_2A.select('B5');
var B6_2A  = s2Composite_2A.select('B6');
var B7_2A  = s2Composite_2A.select('B7');
var B8_2A  = s2Composite_2A.select('B8');
var B8A_2A = s2Composite_2A.select('B8A');
var B11_2A = s2Composite_2A.select('B11');
var B12_2A = s2Composite_2A.select('B12');


// ============================================================
// 9. VEGETATION / WATER / SOIL INDICES
// ============================================================

// NDVI
var NDVI_2A =
  B8_2A
    .subtract(B4_2A)
    .divide(
      B8_2A.add(B4_2A)
    )
    .rename('NDVI');


// GNDVI
var GNDVI_2A =
  B8_2A
    .subtract(B3_2A)
    .divide(
      B8_2A.add(B3_2A)
    )
    .rename('GNDVI');


// NDRE
var NDRE_2A =
  B8A_2A
    .subtract(B5_2A)
    .divide(
      B8A_2A.add(B5_2A)
    )
    .rename('NDRE');


// NDRE2
var NDRE2_2A =
  B8A_2A
    .subtract(B6_2A)
    .divide(
      B8A_2A.add(B6_2A)
    )
    .rename('NDRE2');


// NDWI
var NDWI_2A =
  B3_2A
    .subtract(B8_2A)
    .divide(
      B3_2A.add(B8_2A)
    )
    .rename('NDWI');


// MNDWI
var MNDWI_2A =
  B3_2A
    .subtract(B11_2A)
    .divide(
      B3_2A.add(B11_2A)
    )
    .rename('MNDWI');


// NDBI
var NDBI_2A =
  B11_2A
    .subtract(B8_2A)
    .divide(
      B11_2A.add(B8_2A)
    )
    .rename('NDBI');


// SAVI
var SAVI_2A =
  B8_2A
    .subtract(B4_2A)
    .multiply(1.5)
    .divide(
      B8_2A.add(B4_2A).add(0.5)
    )
    .rename('SAVI');


// EVI
var EVI_2A =
  B8_2A
    .subtract(B4_2A)
    .multiply(2.5)
    .divide(
      B8_2A
        .add(B4_2A.multiply(6))
        .subtract(B2_2A.multiply(7.5))
        .add(1)
    )
    .rename('EVI');


// BSI
var BSI_2A =
  B11_2A
    .add(B4_2A)
    .subtract(B8_2A)
    .subtract(B2_2A)
    .divide(
      B11_2A
        .add(B4_2A)
        .add(B8_2A)
        .add(B2_2A)
    )
    .rename('BSI');


// NBR
var NBR_2A =
  B8_2A
    .subtract(B12_2A)
    .divide(
      B8_2A.add(B12_2A)
    )
    .rename('NBR');


// Red-edge ratio
var RE_Ratio_2A =
  B8A_2A
    .divide(B5_2A)
    .rename('RE_Ratio');


// ============================================================
// 10. CREATE 24-BAND FEATURE STACK
// ============================================================

var featureStack_2A =
  ee.Image.cat([

    // Sentinel-2 spectral bands
    B2_2A,
    B3_2A,
    B4_2A,
    B5_2A,
    B6_2A,
    B7_2A,
    B8_2A,
    B8A_2A,
    B11_2A,
    B12_2A,

    // Vegetation / water / soil indices
    NDVI_2A,
    GNDVI_2A,
    NDRE_2A,
    NDRE2_2A,
    NDWI_2A,
    MNDWI_2A,
    NDBI_2A,
    SAVI_2A,
    EVI_2A,
    BSI_2A,
    NBR_2A,
    RE_Ratio_2A,

    // Terrain
    elevation_2A,
    slope_2A

  ]).toFloat();


// Exact feature-band list
var featureBands_2A = [
  'B2',
  'B3',
  'B4',
  'B5',
  'B6',
  'B7',
  'B8',
  'B8A',
  'B11',
  'B12',

  'NDVI',
  'GNDVI',
  'NDRE',
  'NDRE2',
  'NDWI',
  'MNDWI',
  'NDBI',
  'SAVI',
  'EVI',
  'BSI',
  'NBR',
  'RE_Ratio',

  'Elevation',
  'Slope'
];


// Make absolutely sure band names match.
featureStack_2A =
  featureStack_2A.select(
    featureBands_2A
  );


print(
  'Feature stack:',
  featureStack_2A
);

print(
  'Feature bands:',
  featureBands_2A
);

print(
  'Number of feature bands:',
  featureStack_2A.bandNames().size()
);


// ============================================================
// 11. SAMPLE REFERENCE POLYGONS
// ============================================================

var referenceSamples_2A =
  featureStack_2A.sampleRegions({

    collection:
      allReferencePolygons,

    properties: [
      'class',
      'crop',
      'source'
    ],

    scale:
      analysisScale_2A,

    geometries:
      true,

    tileScale:
      4
  });


// Remove pixels with null feature values
referenceSamples_2A =
  referenceSamples_2A.filter(
    ee.Filter.notNull(
      featureBands_2A
    )
  );


print(
  'Total usable reference samples:',
  referenceSamples_2A.size()
);

print(
  'Banana reference samples:',
  referenceSamples_2A
    .filter(
      ee.Filter.eq('class', 0)
    )
    .size()
);

print(
  'Paddy reference samples:',
  referenceSamples_2A
    .filter(
      ee.Filter.eq('class', 1)
    )
    .size()
);

print(
  'Other reference samples:',
  referenceSamples_2A
    .filter(
      ee.Filter.eq('class', 2)
    )
    .size()
);


// ============================================================
// 12. CLASS MEAN SIGNATURES — RAW FEATURE SPACE
// ============================================================

function getClassMean_2A(classValue) {

  var samples =
    referenceSamples_2A.filter(
      ee.Filter.eq(
        'class',
        classValue
      )
    );

  return ee.Dictionary(
    samples.reduceColumns({
      reducer:
        ee.Reducer.mean()
          .repeat(
            featureBands_2A.length
          ),

      selectors:
        featureBands_2A
    })
  );
}


var bananaRaw_2A =
  getClassMean_2A(0);

var paddyRaw_2A =
  getClassMean_2A(1);

var otherRaw_2A =
  getClassMean_2A(2);


// Convert reducer output to dictionaries
var bananaSignatureRaw_2A =
  ee.Dictionary.fromLists(
    featureBands_2A,
    ee.List(
      bananaRaw_2A.get('mean')
    )
  );

var paddySignatureRaw_2A =
  ee.Dictionary.fromLists(
    featureBands_2A,
    ee.List(
      paddyRaw_2A.get('mean')
    )
  );

var otherSignatureRaw_2A =
  ee.Dictionary.fromLists(
    featureBands_2A,
    ee.List(
      otherRaw_2A.get('mean')
    )
  );


print(
  'Raw Banana signature:',
  bananaSignatureRaw_2A
);

print(
  'Raw Paddy signature:',
  paddySignatureRaw_2A
);

print(
  'Raw Other signature:',
  otherSignatureRaw_2A
);


// ============================================================
// 13. GLOBAL MEAN AND STANDARD DEVIATION
// ============================================================

var globalMeanRaw_2A =
  referenceSamples_2A.reduceColumns({
    reducer:
      ee.Reducer.mean()
        .repeat(
          featureBands_2A.length
        ),

    selectors:
      featureBands_2A
  });


var globalStdRaw_2A =
  referenceSamples_2A.reduceColumns({
    reducer:
      ee.Reducer.stdDev()
        .repeat(
          featureBands_2A.length
        ),

    selectors:
      featureBands_2A
  });


var globalMeanValues_2A =
  ee.List(
    globalMeanRaw_2A.get('mean')
  );


var globalStdValues_2A =
  ee.List(
    globalStdRaw_2A.get('stdDev')
  );


// Prevent division by zero
globalStdValues_2A =
  globalStdValues_2A.map(
    function(value) {

      return ee.Number(value)
        .max(0.000001);

    }
  );


// ============================================================
// 14. STANDARDIZE FEATURE IMAGE
// ============================================================

var standardizedImages_2A =
  ee.List(featureBands_2A).map(
    function(bandName) {

      bandName =
        ee.String(bandName);

      var index =
        ee.List(featureBands_2A)
          .indexOf(bandName);

      var meanValue =
        ee.Number(
          globalMeanValues_2A
            .get(index)
        );

      var stdValue =
        ee.Number(
          globalStdValues_2A
            .get(index)
        );

      return featureStack_2A
        .select(bandName)
        .subtract(meanValue)
        .divide(stdValue)
        .rename(bandName);

    }
  );


// Combine standardized images
var standardizedImage_2A =
  ee.ImageCollection
    .fromImages(
      standardizedImages_2A
    )
    .toBands();


// Restore original band names
standardizedImage_2A =
  standardizedImage_2A.rename(
    featureBands_2A
  );


print(
  'Standardized feature image:',
  standardizedImage_2A
);


// ============================================================
// 15. STANDARDIZE CLASS SIGNATURES
// ============================================================

function standardizeSignature_2A(
  rawSignature
) {

  var result =
    ee.Dictionary({});

  result =
    ee.List(featureBands_2A)
      .iterate(

        function(
          bandName,
          accumulator
        ) {

          bandName =
            ee.String(bandName);

          var index =
            ee.List(featureBands_2A)
              .indexOf(bandName);

          var rawValue =
            ee.Number(
              ee.Dictionary(
                rawSignature
              ).get(bandName)
            );

          var meanValue =
            ee.Number(
              globalMeanValues_2A
                .get(index)
            );

          var stdValue =
            ee.Number(
              globalStdValues_2A
                .get(index)
            );

          var standardizedValue =
            rawValue
              .subtract(meanValue)
              .divide(stdValue);

          return ee.Dictionary(
            accumulator
          ).set(
            bandName,
            standardizedValue
          );

        },

        result
      );

  return ee.Dictionary(result);
}


var bananaSignature_2A =
  standardizeSignature_2A(
    bananaSignatureRaw_2A
  );

var paddySignature_2A =
  standardizeSignature_2A(
    paddySignatureRaw_2A
  );

var otherSignature_2A =
  standardizeSignature_2A(
    otherSignatureRaw_2A
  );


print(
  'Standardized Banana signature:',
  bananaSignature_2A
);

print(
  'Standardized Paddy signature:',
  paddySignature_2A
);

print(
  'Standardized Other signature:',
  otherSignature_2A
);


// ============================================================
// 16. EUCLIDEAN DISTANCE FUNCTION
// ============================================================

function calculateClassDistance_2A(
  signature
) {

  var squaredDistance =
    ee.Image.constant(0)
      .rename(
        'squaredDistance'
      );

  squaredDistance =
    ee.List(featureBands_2A)
      .iterate(

        function(
          bandName,
          accumulator
        ) {

          bandName =
            ee.String(bandName);

          var imageBand =
            standardizedImage_2A
              .select(bandName);

          var signatureValue =
            ee.Number(
              ee.Dictionary(
                signature
              ).get(bandName)
            );

          var difference =
            imageBand
              .subtract(
                signatureValue
              );

          var squared =
            difference.pow(2);

          return ee.Image(
            accumulator
          ).add(squared);

        },

        squaredDistance
      );

  return ee.Image(
    squaredDistance
  )
  .sqrt()
  .rename('distance');
}


// ============================================================
// 17. DISTANCE TO EACH CLASS
// ============================================================

var bananaDistance_2A =
  calculateClassDistance_2A(
    bananaSignature_2A
  );

var paddyDistance_2A =
  calculateClassDistance_2A(
    paddySignature_2A
  );

var otherDistance_2A =
  calculateClassDistance_2A(
    otherSignature_2A
  );


print(
  'Banana distance:',
  bananaDistance_2A
);

print(
  'Paddy distance:',
  paddyDistance_2A
);

print(
  'Other distance:',
  otherDistance_2A
);


// ============================================================
// 18. FIND NEAREST CLASS
// ============================================================

var bananaIsNearest_2A =
  bananaDistance_2A
    .lte(paddyDistance_2A)
    .and(
      bananaDistance_2A
        .lte(otherDistance_2A)
    );


var paddyIsNearest_2A =
  paddyDistance_2A
    .lt(bananaDistance_2A)
    .and(
      paddyDistance_2A
        .lte(otherDistance_2A)
    );


var otherIsNearest_2A =
  otherDistance_2A
    .lt(bananaDistance_2A)
    .and(
      otherDistance_2A
        .lt(paddyDistance_2A)
    );


var nearestClass_2A =
  ee.Image(2)
    .where(
      bananaIsNearest_2A,
      0
    )
    .where(
      paddyIsNearest_2A,
      1
    )
    .rename(
      'nearestClass'
    );


// ============================================================
// 19. BEST + SECOND-BEST DISTANCE
// ============================================================

var bestDistance_2A =
  bananaDistance_2A
    .min(
      paddyDistance_2A
    )
    .min(
      otherDistance_2A
    )
    .rename(
      'bestDistance'
    );


var maximumDistance_2A =
  bananaDistance_2A
    .max(
      paddyDistance_2A
    )
    .max(
      otherDistance_2A
    );


var sumDistance_2A =
  bananaDistance_2A
    .add(
      paddyDistance_2A
    )
    .add(
      otherDistance_2A
    );


var secondBestDistance_2A =
  sumDistance_2A
    .subtract(
      bestDistance_2A
    )
    .subtract(
      maximumDistance_2A
    )
    .rename(
      'secondBestDistance'
    );


// ============================================================
// 20. SEPARATION RATIO
// ============================================================

var separationRatio_2A =
  secondBestDistance_2A
    .divide(
      bestDistance_2A
        .max(0.000001)
    )
    .rename(
      'separationRatio'
    );


// ============================================================
// 21. DIAGNOSTIC STATISTICS
// ============================================================

print(
  'Best distance percentiles:',
  bestDistance_2A.reduceRegion({
    reducer:
      ee.Reducer.percentile([
        5,
        25,
        50,
        75,
        90,
        95
      ]),

    geometry:
      studyArea,

    scale:
      analysisScale_2A,

    maxPixels:
      1e9,

    tileScale:
      4
  })
);


print(
  'Separation ratio percentiles:',
  separationRatio_2A.reduceRegion({
    reducer:
      ee.Reducer.percentile([
        5,
        25,
        50,
        75,
        90,
        95
      ]),

    geometry:
      studyArea,

    scale:
      analysisScale_2A,

    maxPixels:
      1e9,

    tileScale:
      4
  })
);


// ============================================================
// 22. VALID PIXEL MASK
// ============================================================

var validMask_2A =
  featureStack_2A
    .mask()
    .reduce(
      ee.Reducer.min()
    );


// ============================================================
// 23. HIGH-CONFIDENCE PIXELS
// ============================================================

var highConfidence_2A =
  bestDistance_2A
    .lte(
      distanceThreshold_2A
    )
    .and(
      separationRatio_2A
        .gte(
          separationThreshold_2A
        )
    )
    .and(
      validMask_2A
    );


// ============================================================
// 24. CLASS-SPECIFIC CANDIDATE PIXELS
// ============================================================

var bananaCandidateImage_2A =
  ee.Image(1)
    .updateMask(
      highConfidence_2A
        .and(
          nearestClass_2A.eq(0)
        )
    )
    .rename('class');


var paddyCandidateImage_2A =
  ee.Image(1)
    .updateMask(
      highConfidence_2A
        .and(
          nearestClass_2A.eq(1)
        )
    )
    .rename('class');


var otherCandidateImage_2A =
  ee.Image(1)
    .updateMask(
      highConfidence_2A
        .and(
          nearestClass_2A.eq(2)
        )
    )
    .rename('class');


// ============================================================
// 25. SAMPLE IN-STUDY PSEUDO-TRAINING POINTS
// ============================================================

var bananaCandidatePoints_2A =
  bananaCandidateImage_2A.sample({

    region:
      studyArea,

    scale:
      analysisScale_2A,

    numPixels:
      candidatePerClass_2A,

    geometries:
      true,

    seed:
      101,

    dropNulls:
      true,

    tileScale:
      4
  })
  .map(
    function(feature) {

      return feature.set({
        class: 0,
        crop: 'Banana',
        source:
          'PseudoTraining_2A'
      });

    }
  );


var paddyCandidatePoints_2A =
  paddyCandidateImage_2A.sample({

    region:
      studyArea,

    scale:
      analysisScale_2A,

    numPixels:
      candidatePerClass_2A,

    geometries:
      true,

    seed:
      102,

    dropNulls:
      true,

    tileScale:
      4
  })
  .map(
    function(feature) {

      return feature.set({
        class: 1,
        crop: 'Paddy',
        source:
          'PseudoTraining_2A'
      });

    }
  );


var otherCandidatePoints_2A =
  otherCandidateImage_2A.sample({

    region:
      studyArea,

    scale:
      analysisScale_2A,

    numPixels:
      candidatePerClass_2A,

    geometries:
      true,

    seed:
      103,

    dropNulls:
      true,

    tileScale:
      4
  })
  .map(
    function(feature) {

      return feature.set({
        class: 2,
        crop: 'Other',
        source:
          'PseudoTraining_2A'
      });

    }
  );


// ============================================================
// 26. COMBINE PSEUDO-TRAINING POINTS
// ============================================================

var pseudoTraining_2A =
  bananaCandidatePoints_2A
    .merge(
      paddyCandidatePoints_2A
    )
    .merge(
      otherCandidatePoints_2A
    );


// ============================================================
// 27. FINAL COUNTS
// ============================================================

print(
  '============================================================'
);

print(
  'BANANA PSEUDO-TRAINING:',
  bananaCandidatePoints_2A.size()
);

print(
  'PADDY PSEUDO-TRAINING:',
  paddyCandidatePoints_2A.size()
);

print(
  'OTHER PSEUDO-TRAINING:',
  otherCandidatePoints_2A.size()
);

print(
  'TOTAL PSEUDO-TRAINING:',
  pseudoTraining_2A.size()
);

print(
  'Pseudo-training class distribution:',
  pseudoTraining_2A
    .aggregate_histogram(
      'class'
    )
);


// ============================================================
// 28. DISPLAY CANDIDATE POINTS
// ============================================================

Map.addLayer(
  bananaCandidatePoints_2A,
  {
